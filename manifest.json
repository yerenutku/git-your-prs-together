{
  "manifest_version": 3,
  "key": "",
  "name": "Git Your PRs Together",
  "version": "0.8.4",
  "description": "Know when it's your turn on a GitHub pull request: notifications, PR states, My threads and Re-review tabs, auto-viewed files.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://*.ghe.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "Git Your PRs Together"
}
